# ============================================================
# Copia este archivo como .env y completa los valores.
# ============================================================

PORT=3000

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# URL del frontend (para los enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=austral_db

# JWT: usa un valor largo y aleatorio. Puedes generarlo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración del access token
JWT_EXPIRES_IN=15m
# Días de validez del refresh token
REFRESH_TOKEN_DAYS=7

# Envío (en pesos). Si el subtotal llega a ENVIO_GRATIS_DESDE, el envío es 0.
# Deja ENVIO_GRATIS_DESDE vacío para no ofrecer envío gratis.
COSTO_ENVIO=12000
ENVIO_GRATIS_DESDE=150000

# Correo (SMTP). Si SMTP_HOST está vacío, los correos se
# muestran en la consola del backend en lugar de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Austral <no-reply@austral.com>"
